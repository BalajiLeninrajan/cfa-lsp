// Code inside corun and cofor moves into a nested function the translator makes.
#include <cofor.hfa>
void bump( long * total, long v ) { *total += v; }
int main() {
long total = 0;
corun { long step = 2; bump( &total, step ); }
corun bump( &total, 3 );
cofor ( i; 3 ) { bump( &total, i ); }
return total > 0 ? 0 : 1;
}
