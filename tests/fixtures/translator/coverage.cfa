// Array parameters and dimensions, labels, assertions, bracket operators and split lines.
enum Size { N = 4 };
const int M = 3;
int table[N];
struct Vec { int x, y; int cells[M]; };
int ?[?]( Vec v, int i ) { return v.x + i; }
struct Fn { int base; };
int ?()( Fn f, int x ) { return f.base + x; }
struct Pt { int x, y; };
void ?{}( Pt & p, int a, int b, int c ) { p.x = a + b; p.y = c; }
int sum( int n, int a[], int b[N] ) { return n + a[0] + b[1]; }
forall( T | { int ?<?( T, T ); } ) T smaller( T a, T b ) { return a < b ? a : b; }
trait Shape( S ) { int area( S ); };
forall( S | Shape( S ) ) int twice( S s ) { return area( s ) * 2; }
